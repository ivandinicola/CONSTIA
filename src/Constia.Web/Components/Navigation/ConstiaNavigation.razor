@inject NavigationManager Navigation
<nav class="constia-navigation" aria-label="Navegación principal" aria-describedby="navigation-availability">
    <p id="navigation-availability" class="visually-hidden">Logros y Más todavía no están disponibles.</p>
    <ul class="navigation-items">
        <li>
            <NavLink href="/hoy" Match="NavLinkMatch.All" class="@(EnHabitos ? "active" : null)" aria-current="@(EnHabitos ? "location" : null)">
                <img src="@Assets["assets/constia-iconos-v1/constia-hoy.png"]" width="22" height="22" alt="" />
                <span>Hoy</span>
            </NavLink>
        </li>
        <li><NavLink href="/calendario"><img src="@Assets["assets/constia-iconos-v1/constia-calendario.png"]" width="22" height="22" alt="" /><span>Calendario</span></NavLink></li>
        <li><NavLink href="/progreso" aria-current="@(new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/') == "/progreso" ? "page" : null)" data-enhance-nav="false"><img src="@Assets["assets/constia-iconos-v1/constia-progreso.png"]" width="22" height="22" alt="" /><span>Progreso</span></NavLink></li>
        @foreach (var item in Items)
        {
            <li @key="item.Icon">
                <button type="button" disabled aria-label="@(item.Label + ": todavía no disponible")">
                    <img src="@Assets[$"assets/constia-iconos-v1/{item.Icon}"]" width="22" height="22" alt="" />
                    <span>@item.Label</span>
                </button>
            </li>
        }
    </ul>
</nav>

@code {
    private bool EnHabitos => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/') == "/habitos";
    private static readonly (string Label, string Icon)[] Items =
    [
        ("Logros", "constia-logros.png"),
        ("Más", "constia-mas.png")
    ];
}
