@page "/habitos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [StreamRendering]
@layout AppLayout
@using Constia.Web.Habitos
@inject GestionHabitos Gestion
@inject NavigationManager Navigation

@{ var inciertos = Gestion.Inciertos(usuario); }
<PageTitle>Mis hábitos · CONSTIA</PageTitle>
<section class="habits" aria-labelledby="habits-title">
    <header><h1 id="habits-title">Mis hábitos</h1><p>Gestioná tus hábitos y mantené el foco.</p></header>
    <nav aria-label="Estado de hábitos"><span aria-current="page">Activos</span><button disabled>Inactivos · no disponible</button></nav>
    <a class="new-habit" href="/habitos/nuevo"><img src="@Assets["assets/pen005/nuevo-habito.svg"]" width="20" height="20" alt="" />Nuevo hábito</a>
    <p id="habits-status" role="status" tabindex="-1" class="@(string.IsNullOrEmpty(mensaje) ? "visually-hidden" : null)">@mensaje</p>
    @if (volverFoco is not null) { <span id="habits-return" data-target="habito-@volverFoco" data-focus-card="@(Edicion is not null ? "true" : null)" hidden></span> }
    <form method="post" @formname="gestionar-habitos" @onsubmit="EjecutarAsync" data-habits data-enhance>
        <AntiforgeryToken />
        @if (confirmar is not null)
        {
            <dialog class="confirmation" open aria-labelledby="habits-confirm" aria-describedby="habits-confirm-description">
                <div class="confirmation-icon" aria-hidden="true"><img class="warning-art" src="@Assets["assets/pen005/advertencia.svg"]" width="32" height="32" alt="" /></div>
                <h2 id="habits-confirm">Desactivar hábito</h2>
                <p><strong>@confirmar.Nombre</strong></p>
                <p id="habits-confirm-description">Desde hoy, en tu fecha local, dejará de aparecer entre activos. Se conservan los cumplimientos anteriores. No se puede reactivar en V1.</p>
                <button type="submit" name="Accion" value="confirmar|@confirmar.Id">Desactivar</button>
                <button type="submit" name="Accion" value="cancelar|@confirmar.Id" data-cancel-confirmation autofocus>Cancelar</button>
            </dialog>
        }
        @foreach (var incierto in inciertos)
        {
            <section class="uncertain"><p>El resultado de «@incierto.Nombre» sigue incierto.</p>
                <button type="submit" name="Accion" value="comprobar|@incierto.Id" aria-label="Comprobar estado de @incierto.Nombre">Comprobar estado</button>
            </section>
        }
        @if (error is not null)
        {
            <div role="alert"><img class="warning-art" src="@Assets["assets/pen005/advertencia.svg"]" width="32" height="32" alt="" /><h2>No pudimos cargar tus hábitos</h2><p>@error</p><a href="/habitos">Reintentar</a></div>
        }
        else if (habitos is null)
        {
            <div class="loading" role="status"><span class="habits-spinner" aria-hidden="true"></span><p>Cargando tus hábitos…</p></div>
        }
        else if (habitos.Length == 0)
        {
            <div class="empty"><img class="empty-art" src="@Assets["assets/pen005/vacio.svg"]" width="84" height="84" alt="" /><h2>Todavía no tenés hábitos activos</h2><p>Cuando crees un hábito, aparecerá acá.</p><a href="/habitos/nuevo">Crear mi primer hábito</a></div>
        }
        else
        {
            <ul class="habit-list">
                @foreach (var habito in habitos)
                {
                    <li @key="habito.Id"><details>
                        <summary id="habito-@habito.Id">
                            @if (Icono(habito.IconoId) is { } icono) { <img src="@Assets[$"assets/constia-iconos-v1/{icono}"]" width="44" height="44" alt="" /> }
                            <span class="habit-summary-text"><strong>@habito.Nombre</strong><span class="schedule">@Resumen(habito.DiasProgramados)</span></span>
                            <img class="habit-chevron" src="@Assets["assets/pen005/chevron.svg"]" width="10" height="14" alt="" />
                        </summary>
                        <div class="habit-detail">
                            @if (!string.IsNullOrWhiteSpace(habito.Descripcion)) { <p>@habito.Descripcion</p> }
                            <h2>Días programados</h2>
                            <ul class="week" aria-label="Programación semanal">
                                @foreach (var dia in Semana) { <li class="@(habito.DiasProgramados.Contains(dia.Dia) ? "scheduled" : null)" aria-label="@(dia.Nombre + (habito.DiasProgramados.Contains(dia.Dia) ? ": programado" : ": no programado"))">@(dia.Nombre == "miércoles" ? "X" : dia.Nombre[..1].ToUpperInvariant())</li> }
                            </ul>
                            <a href="/habitos/@habito.Id/editar">Editar hábito</a>
                            <div class="habit-state"><span>Estado: Activo</span>
                                @if (!inciertos.Any(e => e.Id == habito.Id))
                                {
                                    <button type="submit" class="state-switch" role="switch" aria-checked="true" aria-label="Desactivar hábito @habito.Nombre" name="Accion" value="pedir|@habito.Id"><span class="switch-track" aria-hidden="true"><span></span></span><span class="visually-hidden">Desactivar</span></button>
                                }
                            </div>
                        </div>
                    </details></li>
                }
            </ul>
        }
    </form>
    <nav class="back-links" aria-label="Navegación de cuenta"><a href="/hoy">Volver a Hoy</a><a href="/cuenta">Cuenta y cerrar sesión</a></nav>
</section>
