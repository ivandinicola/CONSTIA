@page "/habitos/{Id:guid}/historial"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [StreamRendering]
@layout AppLayout
@using Constia.Web.Habitos
@inject ConsultarHistorialHabito Consulta
@inject NavigationManager Navigation

<PageTitle>Historial de hábito · CONSTIA</PageTitle>
<section class="habit-history" aria-labelledby="habit-history-title">
    <header>
        <h1 id="habit-history-title" tabindex="-1" autofocus="@(Foco is not ("anterior" or "siguiente") || resultado?.Error is not null)">Historial de hábito</h1>
        @if ((resultado?.Nombre ?? nombreDuranteCarga) is { } nombre) { <p>@nombre</p> }
    </header>
    <a class="history-back" href="@VolverUrl" data-enhance-nav="false">‹ Volver a @(Inactivos ? "Inactivos" : "Activos")</a>
    @if (resultado is null)
    {
        <div class="history-loading" role="status"><span aria-hidden="true"></span>Cargando historial…</div>
    }
    else if (resultado.Error is { } error)
    {
        <div class="history-error" role="alert">
            <img src="@Assets["assets/pen005/advertencia.svg"]" width="32" height="32" alt="" />
            <h2>@(resultado.SinInicializar ? "Historial aún no disponible" : "No pudimos cargar el historial")</h2>
            <p>@error</p>
        </div>
        <a class="history-retry" href="@Navigation.Uri" data-enhance-nav="false">Reintentar</a>
    }
    else if (resultado.Vista is { } vista)
    {
        var (desde, hasta) = ConsultarCalendario.Rango(vista.Mes);
        var seleccion = vista.Mes.Month == vista.Hoy.Month && vista.Mes.Year == vista.Hoy.Year ? vista.Dias[^1] : vista.Dias[0];
        var puedeAvanzar = vista.Mes < new DateOnly(vista.Hoy.Year, vista.Hoy.Month, 1);
        <div class="history-month">
            <nav class="history-month-nav" aria-label="Navegación mensual">
                @if (vista.Mes > DateOnly.MinValue)
                { <a href="@MesUrl(vista.Mes, -1)" data-enhance-nav="false" aria-label="Mes anterior" autofocus="@(Foco == "anterior" || (Foco == "siguiente" && !puedeAvanzar))">‹</a> }
                else { <span aria-hidden="true">‹</span> }
                <h2 id="history-month" aria-live="polite">@vista.Mes.ToString("MMMM yyyy", Cultura)</h2>
                @if (puedeAvanzar)
                { <a href="@MesUrl(vista.Mes, 1)" data-enhance-nav="false" aria-label="Mes siguiente" autofocus="@(Foco == "siguiente" || (Foco == "anterior" && vista.Mes == DateOnly.MinValue))">›</a> }
                else { <span aria-hidden="true">›</span> }
            </nav>
            <div class="history-grid" data-history-grid role="group" aria-labelledby="history-month">
                @foreach (var dia in PresentacionHabitos.Semana)
                { <span class="weekday" title="@dia.Nombre">@dia.Corto</span> }
                @for (var n = desde.DayNumber; n <= hasta.DayNumber; n++)
                {
                    var fecha = DateOnly.FromDayNumber(n);
                    var indice = n - vista.Mes.DayNumber;
                    if (fecha.Month != vista.Mes.Month)
                    { <span aria-hidden="true"></span> }
                    else if (indice >= vista.Dias.Length)
                    { <span class="future" aria-hidden="true">@fecha.Day</span> }
                    else
                    {
                        var dia = vista.Dias[indice];
                        var (signo, texto) = Estado(dia.Estado);
                        <button type="button" class="history-day @dia.Estado" aria-pressed="@(dia == seleccion ? "true" : "false")"
                                tabindex="@(dia == seleccion ? "0" : "-1")"
                                aria-label="@($"{fecha.ToString("D", Cultura)}. {texto}. {(dia.TieneRegistro ? "Registro guardado" : "Sin registro")}.")"
                                data-history-day="@n" data-fecha="@FechaTexto(fecha)" data-estado="@texto" data-registro="@Registro(dia)">
                            <span aria-hidden="true">@fecha.Day</span>
                            <span aria-hidden="true">@signo @if (dia.TieneRegistro) { <span class="record-dot">●</span> }</span>
                        </button>
                    }
                }
            </div>
        </div>
        <ul class="history-legend" aria-label="Leyenda">
            <li class="cumplido">✓ Cumplido</li><li class="pendiente">○ Pendiente</li>
            <li class="no_programado">– No programado</li><li class="desconocido">? Desconocido</li>
            <li class="record-dot">● Registro guardado</li>
        </ul>
        <section class="history-detail" aria-live="polite" aria-atomic="true">
            <h2 id="history-date">@FechaTexto(seleccion.Fecha)</h2>
            <p>Oportunidad: <strong id="history-opportunity">@Estado(seleccion.Estado).Texto</strong></p>
            <p>Registro: <span id="history-record">@Registro(seleccion)</span></p>
            @if (!vista.Dias.Any(d => d.TieneRegistro)) { <p>Este mes no tiene registros.</p> }
        </section>
    }
</section>
