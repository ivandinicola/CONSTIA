@page "/hoy"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [StreamRendering]
@layout AppLayout
@using System.Globalization
@using Constia.Web.Habitos
@inject CumplirHabito Cumplir
@inject NavigationManager Navigation

<PageTitle>Mi día · CONSTIA</PageTitle>

<section class="today" aria-labelledby="today-title">
    <DayHeader Title="Mi día" TitleId="today-title" Name="@Http.User.Identity?.Name">
        <div class="today-meta">
            @if (dia is not null)
            {
                <time datetime="@dia.Fecha.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                    @dia.Fecha.ToString("dddd d 'de' MMMM", CultureInfo.GetCultureInfo("es-AR"))
                </time>
            }
            <a href="/cuenta">Mi cuenta</a>
        </div>
    </DayHeader>

    <p id="completion-status" role="status" tabindex="-1" class="@(string.IsNullOrWhiteSpace(mensaje) ? "visually-hidden" : null)">@mensaje</p>
    <form method="post" @formname="cumplir" @onsubmit="RegistrarAsync" data-completion data-enhance aria-busy="@(enProceso ? "true" : null)">
        <AntiforgeryToken />
        @foreach (var envio in Cumplir.ListarInciertos(usuario))
        {
            <div class="uncertain-completion">
                <p>El resultado de «@envio.Nombre» del @envio.Fecha.ToString("dd/MM/yyyy") sigue incierto.</p>
                <button type="submit" name="Solicitud" value="@($"{envio.Habito}|{envio.Fecha:yyyy-MM-dd}")"
                        aria-label="@($"Comprobar estado de {envio.Nombre}, {envio.Fecha:dd/MM/yyyy}")">Comprobar estado</button>
            </div>
        }
        @if (error is not null)
        {
            <p role="alert">@error</p>
            <a href="/hoy" data-enhance-nav="false">Reintentar</a>
        }
        else if (dia is null)
        {
            <p role="status">Cargando tus hábitos de hoy…</p>
        }
        else if (dia.Habitos.Length == 0)
        {
            <p role="status">No tenés hábitos programados para hoy.</p>
        }
        else
        {
            var cumplidos = dia.Habitos.Count(habito => habito.Cumplido);
            <section class="today-progress" aria-labelledby="today-progress">
                <h2 id="today-progress">Progreso de hoy</h2>
                <p>@cumplidos de @dia.Habitos.Length hábitos realizados</p>
                <progress value="@cumplidos" max="@dia.Habitos.Length" aria-hidden="true"></progress>
            </section>

            <section aria-labelledby="today-habits">
                <div class="today-habits-heading"><h2 id="today-habits">Tus hábitos de hoy</h2><a href="/habitos">Mis hábitos<span class="habits-chevron" aria-hidden="true"><img src="@Assets["assets/pen005/chevron.svg"]" width="10" height="14" alt="" /></span></a></div>
                <ul class="today-habits">
                    @foreach (var habito in dia.Habitos)
                    {
                        var incierto = !habito.Cumplido && Cumplir.EstaIncierto(usuario, habito.Id, dia.Fecha);
                        <li class="today-habit @(habito.Cumplido ? "is-complete" : null)" @key="habito.Id">
                            @if (PresentacionHabitos.Icono(habito.IconoId) is { } icono)
                            {
                                <span class="habit-icon" data-icon="@habito.IconoId" aria-hidden="true">
                                    <img src="@Assets[$"assets/constia-iconos-v1/{icono}"]" width="32" height="32" alt="" />
                                </span>
                            }
                            <div class="habit-copy">
                                <h3>@habito.Nombre</h3>
                                @if (!string.IsNullOrWhiteSpace(habito.Descripcion))
                                {
                                    <p>@habito.Descripcion</p>
                                }
                            </div>
                            <div class="habit-action">
                            @if (habito.Cumplido)
                            {
                                <span class="habit-status">Realizado <img src="@Assets["assets/pen006/realizado.png"]" width="18" height="18" alt="" /></span>
                            }
                            else if (incierto)
                            {
                                <span class="habit-status">Por comprobar</span>
                            }
                            else
                            {
                                <button class="habit-complete" type="submit" name="Solicitud" value="@($"{habito.Id}|{dia.Fecha:yyyy-MM-dd}")"
                                        aria-label="@($"Marcar como realizado de {habito.Nombre}, {dia.Fecha:dd/MM/yyyy}")">
                                    Marcar como realizado
                                </button>
                            }
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
    </form>
</section>
