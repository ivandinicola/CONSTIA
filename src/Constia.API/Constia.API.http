@Constia.API_HostAddress = http://localhost:5167

GET {{Constia.API_HostAddress}}/weatherforecast/
Accept: application/json

###

GET {{Constia.API_HostAddress}}/api/habitos/diarios?fecha=2026-10-09
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{Constia.API_HostAddress}}/api/habitos/calendario?desde=2026-10-29&hasta=2026-11-02
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{Constia.API_HostAddress}}/api/habitos/{{habitoId}}/cumplimientos
Authorization: Bearer {{token}}
Accept: application/json

###
